---
interface Props {
  id: string;
  network: string;
  ratio?: 'vertical' | 'horizontal';
  className?: string;
}

const { id, network, ratio = 'horizontal', className = '' } = Astro.props;
const provider = ({ tiktok: 'TikTok', youtube: 'YouTube', facebook: 'Facebook', instagram: 'Instagram' } as Record<string, string>)[network] || 'la red social';
---
<div
  class:list={['social-embed', `social-embed--${ratio}`, className]}
  data-social-embed
  data-embed-url={`/api/public/social/${encodeURIComponent(id)}/embed`}
>
  <div class="social-embed__notice">
    <strong>Video de {provider}</strong>
    <span>Al cargarlo, tu navegador se conectará con {provider}.</span>
    <button type="button" data-social-load>Cargar video</button>
    <span class="social-embed__status" data-social-status aria-live="polite"></span>
  </div>
</div>

<script>
  document.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-social-load]');
    if (!button) return;
    const host = button.closest<HTMLElement>('[data-social-embed]');
    if (!host?.dataset.embedUrl || host.dataset.loading === 'true') return;
    const status = host.querySelector<HTMLElement>('[data-social-status]');
    host.dataset.loading = 'true';
    button.disabled = true;
    if (status) status.textContent = 'Cargando…';
    try {
      const response = await fetch(host.dataset.embedUrl);
      if (!response.ok) throw new Error(String(response.status));
      const data = await response.json();
      if (!data.embed_html) throw new Error('sin reproductor');
      host.innerHTML = data.embed_html;
    } catch {
      host.dataset.loading = 'false';
      button.disabled = false;
      if (status) status.textContent = 'No pudimos cargar el video. Usa el enlace de la publicación.';
    }
  });
</script>

<style>
  .social-embed { position: relative; width: 100%; overflow: hidden; background: #172019; }
  .social-embed--vertical { aspect-ratio: 9 / 16; }
  .social-embed--horizontal { aspect-ratio: 4 / 3; }
  .social-embed__notice { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; padding: 22px; color: #fff; text-align: center; }
  .social-embed__notice strong { font: 600 14px/1.3 var(--font-body); }
  .social-embed__notice span { max-width: 260px; font: 12px/1.45 var(--font-body); color: #d9ded9; }
  .social-embed__notice button { border: 1px solid #fff; border-radius: 6px; padding: 8px 12px; background: #fff; color: #172019; font: 600 12px/1 var(--font-body); cursor: pointer; }
  .social-embed__notice button:focus-visible { outline: 3px solid #e1a93b; outline-offset: 3px; }
  .social-embed__notice button:disabled { opacity: .65; cursor: wait; }
  .social-embed__status { min-height: 18px; }
  .social-embed :global(iframe) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; border: 0; }
</style>
