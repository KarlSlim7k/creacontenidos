---
// Puerto de coverHtml() (main.js) — imagen de portada o placeholder "foto: ...".
// `alt` solo cuando la imagen va sola (nota); en tarjetas el título ya está en
// el mismo link, así que alt="" evita que el lector de pantalla lo lea 2 veces.
interface Props {
  coverUrl?: string | null;
  section?: string;
  class?: string;
  style?: string;
  alt?: string;
  sponsored?: boolean;
  eager?: boolean;
  imageWidth?: number;
  imageHeight?: number;
}
const { coverUrl, section = 'CREA', class: cls, style, alt = '', sponsored = false, eager = false, imageWidth = 640, imageHeight = 480 } = Astro.props;
const internalImage = coverUrl?.startsWith('/api/public/images/');
const src = internalImage ? `${coverUrl}?w=${imageWidth}` : coverUrl;
const srcset = internalImage ? `${coverUrl}?w=640 640w, ${coverUrl}?w=1200 1200w` : undefined;
---
<div class:list={['img-ph', cls]} style={style}>
  {src
    ? <img src={src} srcset={srcset} sizes={srcset ? '(max-width: 720px) calc(100vw - 40px), 640px' : undefined} alt={alt} width={imageWidth} height={imageHeight} style="width:100%;height:100%;object-fit:cover;border-radius:inherit;"
        loading={eager ? 'eager' : 'lazy'} decoding={eager ? undefined : 'async'} fetchpriority={eager ? 'high' : undefined}>
    : <span class="cap">foto: {section.toLowerCase()}</span>}
  {sponsored && <span class="sponsored-tag">CONTENIDO PATROCINADO</span>}
</div>
